++#!/usr/bin/env python3
++"""Read Coqui trainer log lines and POST loss deltas to /api/strand/control."""
++
++import argparse
++import json
++import re
++import urllib.request
++
++P = re.compile(r"avg_(?P<name>[a-zA-Z0-9_]+):\s*(?P<val>-?\d+(?:\.\d+)?)\s*\((?P<delta>[+-]?\d+(?:\.\d+)?)\)")
++
++def parse(path):
++    txt = open(path, "r", encoding="utf-8", errors="ignore").read()
++    out = {}
++    for m in P.finditer(txt):
++        out[f"avg_{m.group('name')}"] = {
++            "value": float(m.group("val")),
++            "delta": float(m.group("delta")),
++        }
++    return out
++
++def main():
++    ap = argparse.ArgumentParser()
++    ap.add_argument("--log", required=True)
++    ap.add_argument("--url", default="http://127.0.0.1:11434/api/strand/control")
++    ap.add_argument("--round", type=int, default=0)
++    args = ap.parse_args()
++
++    payload = {"round": args.round, "metrics": parse(args.log)}
++    req = urllib.request.Request(
++        args.url,
++        data=json.dumps(payload).encode("utf-8"),
++        headers={"Content-Type": "application/json"},
++        method="POST",
++    )
++    with urllib.request.urlopen(req, timeout=30) as r:
++        print(r.read().decode("utf-8", errors="ignore"))
++
++if __name__ == "__main__":
++    main()
+
